# =============================================================================
# Online Competitions Turborepo — Environment Variable Reference
# =============================================================================
# This file is a combined reference only. It is NOT loaded by any app.
#
# Each app has its own .env.example template:
#   apps/admin/.env.example        → copy to .env.local
#   apps/web-lander/.env.example   → copy to .env.local
#   apps/client/.env.example       → copy to .env.local
#   apps/admin/.env.coolify.prod
#   apps/admin/.env.coolify.staging
#   apps/web-lander/.env.coolify.prod
#   apps/web-lander/.env.coolify.staging
#
# Secret generation:
#   BETTER_AUTH_SECRET            openssl rand -hex 32
#   SETUP_SECRET                  openssl rand -base64 32  (server only — /auth/setup)
#   ADMIN_EMERGENCY_SECRET        openssl rand -base64 32  (server only — /auth/emergency)
#   CRON_JOBS_SECRET              openssl rand -base64 32  (VPS cron — /api/internal/jobs)
#
# IMPORTANT: Each app has its own unique BETTER_AUTH_SECRET.
# Customer sessions and admin sessions are fully isolated.
# Do NOT put setup/emergency/cron secrets in NEXT_PUBLIC_* (browser-visible).
# =============================================================================

# --- admin app URLs ---
# ADMIN_BETTER_AUTH_URL           http://localhost:3222
# ADMIN_URL                       http://localhost:3222
# NEXT_PUBLIC_ADMIN_URL           http://localhost:3222
# NEXT_PUBLIC_FRONTEND_URL        http://localhost:3555

# --- web-lander app URLs ---
# NEXT_PUBLIC_LANDER_API_URL      http://localhost:3333
# NEXT_PUBLIC_APP_URL             http://localhost:3333

# --- client app URLs (Vike) ---
# NEXT_PUBLIC_APP_URL             http://localhost:3555
# NEXT_PUBLIC_SELF_URL            http://localhost:3555
# NEXT_PUBLIC_ADMIN_URL           http://localhost:3222
# NEXT_PUBLIC_LOGIN_URL           /login
# NEXT_PUBLIC_LANDER_API_URL      http://localhost:3333

# --- Auth ---
# BETTER_AUTH_SECRET              <unique per app, openssl rand -hex 32>
# CROSS_SUBDOMAIN_COOKIES         false
# RATE_LIMIT_AUTH                 1
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET

# --- Admin secrets (server env only) ---
# SETUP_SECRET                    <openssl rand -base64 32>
# ADMIN_EMERGENCY_SECRET          <openssl rand -base64 32>
# CRON_JOBS_SECRET                <openssl rand -base64 32>  (separate from emergency UI secret)

# --- Payment ---
# NEXT_PUBLIC_PAYMENT_BYPASS      true
# ENABLE_LOCAL_PAYMENT_METHOD     true
# PAYTRIOT_MERCHANT_ID             e.g. 105631 (test MID)
# PAYTRIOT_MERCHANT_SECRET         e.g. Media49Stone36Carrot (test secret)
# PAYTRIOT_ENVIRONMENT             sandbox
# PAYTRIOT_STATEMENT_NARRATIVE_1   Paytrio*Ukcomp
# PAYTRIOT_STATEMENT_NARRATIVE_2   02038841611
# PAYTRIOT_CURRENCY                GBP
# STRIPE_PUBLISHABLE_KEY           pk_test_xxx
# STRIPE_SECRET_KEY                sk_test_xxx
# STRIPE_WEBHOOK_SECRET            whsec_xxx
# STRIPE_ENVIRONMENT               test
# STRIPE_CURRENCY                  GBP
# STRIPE_HTTP_TIMEOUT_MS           15000
# STRIPE_HTTP_RETRIES              2
# STRIPE_TEST_SECRET_KEY           sk_test_xxx
# STRIPE_TEST_PUBLISHABLE_KEY      pk_test_xxx
# STRIPE_TEST_WEBHOOK_SECRET       whsec_test_xxx  (documented, NOT wired)
# STRIPE_LIVE_SECRET_KEY           sk_live_xxx
# STRIPE_LIVE_PUBLISHABLE_KEY      pk_live_xxx
# STRIPE_LIVE_WEBHOOK_SECRET       whsec_live_xxx  (documented, NOT wired)
# PUBLIC_WEBHOOK_URL               https://api.example.com
#   Base URL for the SINGLE unified Stripe webhook endpoint per environment
#   (POST /api/payments/webhook/stripe handles both shop and orders events).
#   Defaults to APP_URL when unset.
# STRIPE_WEBHOOK_SECRET            Optional. When unset, bootstrap auto-registers
#   the unified endpoint and persists the returned signing secret in the
#   PaymentMethod doc (resolution order: memory -> env -> DB). When set, it is
#   used directly and auto-registration is skipped (manual mode).
#   STRIPE_TEST_WEBHOOK_SECRET / STRIPE_LIVE_WEBHOOK_SECRET are currently unused
#   by code — documented for clarity, not wired.

# --- Database ---
# DATABASE_URL                    mongodb://root:onlinecompetitions_dev_password@localhost:27017/onlinecompetitions?authSource=admin
# MONGODB_SYNC_INDEXES_ON_STARTUP true   # syncIndexes on API startup (also: bun run packages/api/server/src/lib/jobs/sync-mongo-indexes.ts)
# MONGODB_ORDER_COMPLETED_TTL_DAYS 2555  # 0 = disable TTL on completed/refunded orders
# MONGODB_ORDER_FAILED_TTL_DAYS     180    # 0 = keep failed orders indefinitely
# MONGODB_ORDER_PENDING_TTL_DAYS    7
# MONGODB_READ_SECONDARY            false  # route heavy admin analytics aggregates to secondaries
# MONGODB_ENFORCE_AGGREGATE_MAX_TIME_MS true
# API_REQUIRE_DB_AT_STARTUP       true
# API_EXIT_ON_FATAL_ERROR         true

# --- Email (Mailpit) ---
# SEND_EMAIL                      true
# EMAIL_HOST                      localhost
# EMAIL_PORT                      1025
# EMAIL_FROM                      noreply@onlinecompetitions.local
# EMAIL_SECURE                    false

# --- S3 (MinIO) ---
# S3_ENDPOINT                     http://localhost:9011
# AWS_ACCESS_KEY_ID               oc_dev_access_key
# AWS_SECRET_ACCESS_KEY           oc_dev_secret_key
# S3_BUCKET                       onlinecompetitions-assets
# AWS_REGION                      us-east-1
# ASSET_BASE_URL                  http://localhost:9011/onlinecompetitions-assets

# --- Sentry (optional) ---
# NEXT_PUBLIC_SENTRY_DSN_WEB
# NEXT_PUBLIC_SENTRY_DSN_ADMIN
# NEXT_PUBLIC_SENTRY_ENVIRONMENT  development
# SENTRY_DSN
# SENTRY_ENVIRONMENT              development

# --- Runtime ---
# LOG_ERROR_STACKS                true
# LOG_DB_CONNECT_DEBUG            true
# Production: NEXT_PUBLIC_ASSET_BASE_URL=https://assets.onlinecompetitions.co.uk
# NEXT_PUBLIC_ASSET_BASE_URL=https://assets.staging.onlinecompetitions.co.uk

# --- Cache (Redis) ---
# REDIS_URL                       redis://localhost:6379
# REDIS_NAMESPACE                 onlinecompetitions
# REDIS_TTL_DEFAULT               60
# REDIS_ENABLED                   true
# Set REDIS_ENABLED=false in dev to bypass cache and see live changes

# --- Turnstile CAPTCHA ---
# TURNSTILE_SECRET_KEY
# TURNSTILE_SITE_KEY
