# =============================================================================
# apps/admin — Environment Template
# Copy to .env.local and fill in secrets:
#   cp .env.example .env.local
# =============================================================================
# NOTE: SETUP_SECRET and ADMIN_EMERGENCY_SECRET belong in server env only (onlinecompetitions-api / apps/admin .env.local).
# Do not use NEXT_PUBLIC_* for these — they would be exposed in the browser bundle.
# Users enter setup/emergency secrets manually on /auth/setup and /auth/emergency.

# --- Generated secrets (unique per developer) ---
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32 — server only (must match API SETUP_SECRET)
# SETUP_SECRET=
# openssl rand -base64 32 — server only (must match API ADMIN_EMERGENCY_SECRET)
# ADMIN_EMERGENCY_SECRET=
# openssl rand -base64 32 — VPS cron only (header X-Cron-Jobs-Secret, NOT the emergency UI secret)
# CRON_JOBS_SECRET=

# --- Runtime ---
FRAMEWORK=next

# --- App URLs ---
APP_URL=http://localhost:3222
BETTER_AUTH_URL=http://localhost:3222
ADMIN_BETTER_AUTH_URL=http://localhost:3222
ADMIN_URL=http://localhost:3222
NEXT_PUBLIC_ADMIN_URL=http://localhost:3222
NEXT_PUBLIC_APP_URL=http://localhost:3222
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3111
NEXT_PUBLIC_LOGIN_URL=/auth/login

# --- Auth ---
CROSS_SUBDOMAIN_COOKIES=false
RATE_LIMIT_AUTH=0

# --- Payment ---
# Stripe
# STRIPE_PUBLISHABLE_KEY           pk_test_xxx
# STRIPE_SECRET_KEY                sk_test_xxx
# STRIPE_WEBHOOK_SECRET            whsec_xxx
# STRIPE_ENVIRONMENT               test
# STRIPE_CURRENCY                  GBP
# STRIPE_HTTP_TIMEOUT_MS           15000
# STRIPE_HTTP_RETRIES              2
# STRIPE_TEST_SECRET_KEY           sk_test_xxx
# STRIPE_TEST_PUBLISHABLE_KEY      pk_test_xxx
# STRIPE_TEST_WEBHOOK_SECRET       whsec_test_xxx
# STRIPE_LIVE_SECRET_KEY           sk_live_xxx
# STRIPE_LIVE_PUBLISHABLE_KEY      pk_live_xxx
# STRIPE_LIVE_WEBHOOK_SECRET       whsec_live_xxx

# --- MongoDB ---
DATABASE_URL=mongodb://root:onlinecompetitions_dev_password@localhost:27017/onlinecompetitions?authSource=admin

# --- Email (Mailpit) ---
SEND_EMAIL=true
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025

# --- S3 (MinIO) ---
S3_ENDPOINT=http://localhost:9011
AWS_ACCESS_KEY_ID=oc_dev_access_key
AWS_SECRET_ACCESS_KEY=oc_dev_secret_key
S3_BUCKET=onlinecompetitions-assets
AWS_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- Turnstile CAPTCHA ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Cloudflare Turnstile secret key — same value used in apps/client/.env
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Umami Analytics ---
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Sentry (optional) ---
NEXT_PUBLIC_SENTRY_DSN_ADMIN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
