# API server URL
VITE_API_URL=https://api.onlinecompetitions.co.uk

# Optional: Sentry DSN for error tracking
VITE_SENTRY_DSN=

# Optional: Environment name
VITE_SENTRY_ENVIRONMENT=mobile

# --- Payment (Stripe) ---
