[Unit]
Description=Online Competitions admin (Next.js)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/var/www/onlinecompetitions/app/apps/admin
EnvironmentFile=/var/www/onlinecompetitions/app/apps/admin/.env.local
Environment=PORT=3222
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/local/bin/bun run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
