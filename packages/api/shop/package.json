{
  "name": "@oc/api-shop",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "seed": "bun run src/seed.ts"
  },
  "dependencies": {
    "@oc/api-db": "workspace:*",
    "@oc/api-infra": "workspace:*",
    "@oc/api-errors": "workspace:*",
    "@oc/types": "workspace:*",
    "@oc/api-logger": "workspace:*",
    "@oc/api-payment-local": "workspace:*",
    "@oc/utils": "workspace:*",
    "@oc/api-email": "workspace:*",
    "@oc/env": "workspace:*",
    "@react-email/render": "^2.0.8",
    "mongoose": "^9.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.19",
    "@types/node": "^20.11.17",
    "mongodb-memory-server": "^10.4.0",
    "vitest": "^4.1.8"
  }
}
