{
  "name": "@oc/api-server",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./*": "./src/*.ts",
    "./lib/payment/providers": "./src/lib/payment/providers/index.ts",
    "./lib/payment/providers/*": "./src/lib/payment/providers/*.ts",
    "./lib/push": "./src/lib/push/index.ts",
    "./lib/jobs": "./src/lib/jobs/index.ts",
    "./middleware/*": "./src/middleware/*.ts",
    "./routes/*": "./src/routes/*.ts",
    "./routes/client/*": "./src/routes/client/*.ts",
    "./routes/common/*": "./src/routes/common/*.ts",
    "./routes/admin/*": "./src/routes/admin/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@oc/api-affiliate": "workspace:*",
    "@oc/api-axios": "workspace:*",
    "@oc/api-compliance": "workspace:*",
    "@oc/api-db": "workspace:*",
    "@oc/api-email": "workspace:*",
    "@oc/api-errors": "workspace:*",
    "@oc/api-infra": "workspace:*",
    "@oc/api-logger": "workspace:*",
    "@oc/api-payment-core": "workspace:*",
    "@oc/api-shop": "workspace:*",
    "@oc/api-payment-paytriot": "workspace:*",
    "@oc/api-payment-stripe": "workspace:*",
    "@oc/api-payment-local": "workspace:*",
    "@oc/api-referrals": "workspace:*",
    "@oc/api-storage": "workspace:*",
    "@oc/api-tickets": "workspace:*",
    "@oc/api-validation": "workspace:*",
    "@oc/auth-admin": "workspace:*",
    "@oc/env": "workspace:*",
    "@oc/types": "workspace:*",
    "@oc/utils": "workspace:*",
    "@react-email/render": "^2.0.8",
    "@sentry/node": "^8.55.0",
    "better-auth": "^1.6.11",
    "dotenv": "^17.4.2",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.12.15",
    "image-size": "^2.0.2",
    "ioredis": "^5.6.1",
    "sharp": "^0.34.5",
    "mongodb": "~7.2.0",
    "mongoose": "^9.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.19",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.11.17",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
