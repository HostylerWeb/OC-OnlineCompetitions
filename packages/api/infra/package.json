{
  "name": "@oc/api-infra",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./cache": "./src/cache/index.ts",
    "./cache/*": "./src/cache/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@oc/api-logger": "workspace:*",
    "@oc/api-validation": "workspace:*",
    "@oc/env": "workspace:*",
    "@oc/types": "workspace:*",
    "@sentry/node": "^8.55.0",
    "hono": "^4.12.15",
    "ioredis": "^5.6.1",
    "mongoose": "^9.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.19",
    "@types/node": "^20.11.17",
    "vitest": "^4.1.8"
  }
}
