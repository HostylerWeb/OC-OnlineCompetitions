{
  "name": "@oc/api-db",
  "private": true,
  "type": "module",
"exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./models": "./src/models/index.ts",
    "./models/*": "./src/models/*.ts",
    "./aggregation-helpers": "./src/aggregation-helpers.ts",
    "./plugins/*": "./src/plugins/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@oc/api-infra": "workspace:*",
    "@oc/types": "workspace:*",
    "@oc/utils": "workspace:*",
    "mongoose": "^9.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.19",
    "@types/node": "^20.11.17"
  }
}
